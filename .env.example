# Required: keep this value empty in Git. Fill it locally or in GitHub Secrets.
OPENAI_API_KEY=

# The OpenAI-compatible endpoint requested for this project.
OPENAI_BASE_URL=http://35.220.164.252:3888/v1/

# Change this if your API provider exposes a different model name.
OPENAI_MODEL=gpt-4o-mini

# DeepSeek also uses this project's OpenAI-compatible settings. To switch:
# OPENAI_API_KEY=your DeepSeek API key
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash

# Kimi/Moonshot China API example:
# OPENAI_API_KEY=your Kimi API key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=kimi-k2.6

# IMPORTANT: the configured API endpoint uses HTTP rather than HTTPS.
# Leave false until you understand that an HTTP connection can expose the API key in transit.
# Prefer changing OPENAI_BASE_URL to an HTTPS endpoint. If HTTP is unavoidable, explicitly set true.
ALLOW_INSECURE_API_BASE=false

# Optional: when blank, the report is generated locally but is not sent to Feishu.
FEISHU_WEBHOOK=
FEISHU_SECRET=

# Optional runtime settings.
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

